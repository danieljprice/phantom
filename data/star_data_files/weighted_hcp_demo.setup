# Analytic polytrope; no external stellar profile is required.
mass_unit = solarm
dist_unit = solarr
iprofile1 = 2
Mstar1 = 1*msun
Rstar1 = 1*rsun
np1 = 4096
particle_lattice1 = weighted_hcp
hcp_density_exponent1 = 0.
hcp_nnopt1 = 23
hcp_surface_factor1 = 1.3
hcp_hfloor1 = 0.
ieos = 2
gamma = 1.6666666666666667
use_var_comp = F
mu = 0.5988
relax = F
tol_ekin = 1.e-7
maxits = 1000
write_rho_to_file = F
