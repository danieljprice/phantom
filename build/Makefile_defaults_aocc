# default settings for aocc compiler
# override these in the Makefile
FC= flang
FFLAGS= -O3 -march=native -Qunused-arguments -flto=auto
DBLFLAG= -fdefault-real-8 -fdefault-double-8
DEBUGFLAG= -fcheck=all -g --debug

CC = clang
CCFLAGS = -O3 -march=native -flto=auto
LIBCXX = -cxxlib
KNOWN_SYSTEM=yes

OMPFLAGS= -fopenmp
LTO_DEFAULT= yes
ifeq ($(UNAME), Darwin)
   LDFLAGS+=-L/opt/homebrew/opt/libomp/lib
endif

ifeq ($(NOWARN), yes)
    FFLAGS+= -Werror
endif
